---
import Button from '#components/button.astro'
import { css, cx } from 'styled-system/css'
const navId = crypto.randomUUID()

type Props = {
	class?: string
}

// Clipped window showing one line; the track holds both words stacked and
// slides up by one line on toggle (odometer roll) for continuous motion.
const labelClass = css({
	display: 'block',
	overflow: 'hidden',
	height: '1.5em', // one line of the `label` textStyle (lineHeight 1.5)
	textStyle: 'label',
	pl: '0.3em', // optical centering for the trailing letter-spacing
})

const trackClass = css({
	display: 'flex',
	flexDirection: 'column',
	translate: '0 0',
	transition: 'translate 0.45s cubic-bezier(0.76, 0, 0.24, 1)',
	'[data-open] &': { translate: '0 -1.5em' },
})

const wordClass = css({
	display: 'block',
	height: '1.5em',
	lineHeight: '1.5',
	flexShrink: 0,
})

const navClass = css({
	position: 'fixed',
	inset: 0,
	zIndex: 10,
	display: 'none',
	opacity: 0,
	bg: 'surfaceAccent.1',
	transition: 'all 0.5s',
	transitionBehavior: 'allow-discrete',
	'[data-open] &': {
		display: 'block',
		opacity: 1,
	},
	'@starting-style': {
		'[data-open] &': {
			opacity: 0,
		},
	},
})
---

<c-hamburger
	class={cx(css({ zIndex: 20 }), Astro.props.class)}
	transition:persist
	transition:name="hamburger"
>
	<Button
		class={css({ position: 'relative', zIndex: 20, _hover: { bg: 'transparent' } })}
		data-hamburger-button
		aria-expanded="false"
		aria-controls={navId}
	>
		<span class={labelClass} aria-hidden="true">
			<span class={trackClass}>
				<span class={wordClass}>Menu</span>
				<span class={wordClass}>Fermer</span>
			</span>
		</span>
		<span class={css({ srOnly: true })} data-hamburger-label>Ouvrir le menu</span>
	</Button>
	<nav id={navId} role="dialog" aria-modal="true" class={navClass}>
		<slot />
	</nav>

	<script>
		import { createFocusTrap, type FocusTrap } from 'focus-trap'
		customElements.define(
			'c-hamburger',
			class Hamburger extends HTMLElement {
				#button: HTMLElement | null = null
				#label: HTMLElement | null = null
				#isOpen = false
				#focusTrap: FocusTrap | null = null

				constructor() {
					super()
					this.#isOpen = false
				}

				connectedCallback() {
					this.#button = this.querySelector('button[data-hamburger-button]')
					this.#label = this.querySelector('[data-hamburger-label]')

					this.#button?.addEventListener('click', this.#handleClick)

					document.addEventListener('astro:before-preparation', this.#close)

					this.#focusTrap = createFocusTrap(this, {
						escapeDeactivates: false,
						clickOutsideDeactivates: false,
					})
				}

				disconnectedCallback() {
					this.#button?.removeEventListener('click', this.#handleClick)
					document.removeEventListener('astro:before-preparation', this.#close)
				}

				#handleClick = () => {
					if (this.#isOpen) this.#close()
					else this.#open()
				}

				#open = () => {
					this.#isOpen = true
					this.toggleAttribute('data-open', this.#isOpen)
					this.#button?.setAttribute('aria-expanded', 'true')
					if (this.#label) this.#label.textContent = 'Fermer le menu'
					this.#focusTrap?.activate()
					document.body.addEventListener('keydown', this.#handleKeydown)
					document.body.classList.toggle('overflow-hidden', true)
				}

				#close = () => {
					this.#isOpen = false
					this.toggleAttribute('data-open', this.#isOpen)
					this.#button?.setAttribute('aria-expanded', 'false')
					if (this.#label) this.#label.textContent = 'Ouvrir le menu'
					this.#focusTrap?.deactivate()
					document.body.removeEventListener('keydown', this.#handleKeydown)
					document.body.classList.toggle('overflow-hidden', false)
				}

				#handleKeydown = (e: KeyboardEvent) => {
					if (e.code === 'Escape') this.#close()
				}
			}
		)
	</script>
</c-hamburger>
