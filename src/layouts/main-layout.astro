---
import '../style.css'
import DesktopNav from '#features/navigation/components/desktop-nav.astro'
import MobileNav from '#features/navigation/components/mobile-nav.astro'
import { ClientRouter } from 'astro:transitions'
import TransitionProgress from '#components/transition-progress.astro'
import { css } from 'styled-system/css'
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Vanessa Noizet</title>
		<ClientRouter />
	</head>
	<body class={css({ textStyle: 'body', fontFamily: 'serif' })}>
		<TransitionProgress />
		<header class={css({ md: { bg: 'surface.1', position: 'sticky', top: '0' } })}>
			<DesktopNav class={css({ display: 'none', md: { display: 'block' } })} />
			<MobileNav
				class={css({ position: 'fixed', top: '3', right: '6', md: { display: 'none' } })}
			/>
		</header>

		<main>
			<slot />
		</main>
	</body>
</html>
