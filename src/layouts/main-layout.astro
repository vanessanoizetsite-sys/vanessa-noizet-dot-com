---
import '../style.css'
import DesktopNav from '#features/navigation/components/desktop-nav.astro'
import MobileNav from '#features/navigation/components/mobile-nav.astro'
import { ClientRouter } from 'astro:transitions'
import TransitionProgress from '#components/transition-progress.astro'
import { css } from 'styled-system/css'
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Vanessa Noizet</title>
		<ClientRouter />
	</head>
	<body class={css({ textStyle: 'body', fontFamily: 'serif' })}>
		<TransitionProgress />
		<header class={css({ md: { bg: 'surface.1', position: 'sticky', top: '0', zIndex: 10 } })}>
			<a
				href="/"
				class={css({
					display: 'block',
					textAlign: 'center',
					textStyle: 'heading-4',
					fontStyle: 'italic',
					fontWeight: 'light',
					color: 'default',
					letterSpacing: '0.04em',
					px: '16',
					py: '4',
					md: { display: 'none' },
				})}
			>
				Vanessa Noizet
			</a>
			<DesktopNav class={css({ display: 'none', md: { display: 'block' } })} />
			<MobileNav
				class={css({ position: 'fixed', top: '3', right: '4', md: { display: 'none' } })}
			/>
		</header>

		<main>
			<slot />
		</main>
	</body>
</html>
