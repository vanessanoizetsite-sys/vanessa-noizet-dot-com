---
import { css, cx } from 'styled-system/css'

interface Props {
	class?: string
}

const { class: className } = Astro.props

const proseClass = cx(
	css({
		maxWidth: '65ch',
		lineHeight: '1.7',

		'& > * + *': {
			marginBlockStart: 'var(--flow-space, 1em)',
		},

		'& :is(h2, h3, h4, h5, h6)': {
			'--flow-space': '1.5em',
			textWrap: 'balance',
			fontWeight: 'bold',
		},

		'& :is(h2, h3, h4, h5, h6) + *': {
			'--flow-space': '0.5em',
		},

		'& h2': { textStyle: 'heading-2' },
		'& h3': { textStyle: 'heading-3' },
		'& h4': { textStyle: 'heading-4' },
		'& h5': { textStyle: 'heading-5' },
		'& h6': { textStyle: 'heading-6' },

		'& blockquote': {
			borderInlineStart: '0.3em solid',
			borderColor: 'separator',
			paddingInlineStart: '1em',
			fontStyle: 'italic',
			textStyle: 'heading-5',
		},

		'& :is(ul, ol)': {
			paddingInlineStart: '1em',
		},

		'& a': {
			color: 'currentColor',
			textDecorationColor: 'muted',
			textUnderlineOffset: '0.3ex',
		},

		'& a:hover': {
			textDecorationColor: 'currentColor',
		},
	}),
	className
)
---

<div class={proseClass}>
	<slot />
</div>
