---
import MainLayout from '#layouts/main-layout.astro'
import Prose from '#components/prose.astro'
import { siteConfig } from '#config/site'
import { getCollection, render } from 'astro:content'
import { css } from 'styled-system/css'
import { container } from 'styled-system/patterns'

const entries = await getCollection('livredor')
entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const renderedEntries = await Promise.all(
	entries.map(async (entry) => ({
		...entry,
		Content: (await render(entry)).Content,
	}))
)

const sectionClass = css({ py: '10', md: { py: '14' } })

const headerClass = css({
	textAlign: 'center',
	mb: '12',
	md: { mb: '16' },
})

const h1Class = css({
	textStyle: 'heading-1',
	fontWeight: 'normal',
	fontStyle: 'italic',
	color: 'default',
	letterSpacing: '-0.01em',
	lineHeight: '1',
})

const wrapClass = css({
	maxWidth: '52rem',
	marginInline: 'auto',
})

const introClass = css({
	pb: '10',
	mb: '10',
	borderBottomWidth: '1px',
	borderColor: 'separator',
	md: { pb: '12', mb: '12' },
})

const introTextClass = css({
	textStyle: 'body',
	color: 'default',
	lineHeight: '1.7',
	'& a': {
		color: 'default',
		textDecorationColor: 'muted',
		textUnderlineOffset: '0.3ex',
		_hover: { textDecorationColor: 'currentColor' },
	},
})

const entriesClass = css({
	display: 'flex',
	flexDirection: 'column',
})

const articleClass = css({
	py: '8',
	borderBottomWidth: '1px',
	borderColor: 'separator',
})

const entryHeaderClass = css({
	display: 'flex',
	alignItems: 'baseline',
	justifyContent: 'space-between',
	gap: '4',
	mb: '5',
	flexWrap: 'wrap',
})

const authorClass = css({
	textStyle: 'heading-5',
	fontWeight: 'normal',
	fontStyle: 'italic',
	color: 'default',
})

const dateClass = css({
	textStyle: 'label',
	color: 'muted',
	fontVariantNumeric: 'oldstyle-nums',
	flexShrink: '0',
})
---

<MainLayout
	title="Livre d'or"
	description="Hommages et messages laissés en mémoire de Vanessa Noizet."
>
	<section class={sectionClass}>
		<div class={container()}>
			<header class={headerClass}>
				<h1 class={h1Class}>Livre d'or</h1>
			</header>

			<div class={wrapClass}>
				<div class={introClass}>
					<p class={introTextClass}>
						Si vous souhaitez contribuer écrivez-nous à <a
							href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a
						>.
					</p>
				</div>

				<div class={entriesClass}>
					{
						renderedEntries.map((entry) => (
							<article class={articleClass}>
								<header class={entryHeaderClass}>
									<h2 class={authorClass}>{entry.data.title}</h2>
									<time class={dateClass} datetime={entry.data.date.toISOString().slice(0, 10)}>
										{entry.data.date.toLocaleDateString('fr-FR', {
											year: 'numeric',
											month: 'long',
										})}
									</time>
								</header>
								<Prose>
									<entry.Content />
								</Prose>
							</article>
						))
					}
				</div>
			</div>
		</div>
	</section>
</MainLayout>
