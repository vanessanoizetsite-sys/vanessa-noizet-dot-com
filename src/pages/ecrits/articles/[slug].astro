---
import MainLayout from '#layouts/main-layout.astro'
import Prose from '#components/prose.astro'
import Button from '#components/button.astro'
import { getStaticPathsFromCollection } from '#utils/get-static-paths-from-collection.ts'
import { render } from 'astro:content'
import { css } from 'styled-system/css'
import { container } from 'styled-system/patterns'
import { DownloadIcon } from '@lucide/astro'

export const getStaticPaths = getStaticPathsFromCollection('articles')
const post = Astro.props
const { Content } = await render(post)

const wrapperClass = css({
	maxWidth: '65ch',
	marginInline: 'auto',
})

const titleClass = css({
	textStyle: 'heading-2',
	fontWeight: 'bold',
	color: 'default',
	textWrap: 'balance',
})

const metaClass = css({
	display: 'flex',
	alignItems: 'center',
	gap: '4',
	mt: '3',
	pb: '6',
	mb: '6',
	borderBottomWidth: '1px',
	borderColor: 'separator',
})

const dateClass = css({
	textStyle: 'caption',
	color: 'muted',
	textTransform: 'uppercase',
	letterSpacing: 'wide',
})
---

<MainLayout>
	<article class={css({ py: '8', md: { py: '12' } })}>
		<div class={container()}>
			<div class={wrapperClass}>
				<header>
					<h1 class={titleClass}>{post.data.title}</h1>
					<div class={metaClass}>
						<time class={dateClass}>
							{post.data.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' })}
						</time>
						{
							post.data.pdf && (
								<Button as="a" href={post.data.pdf} target="_blank">
									<DownloadIcon size={16} />
									Télécharger le PDF
								</Button>
							)
						}
					</div>
				</header>
				<Prose>
					<Content />
				</Prose>
			</div>
		</div>
	</article>
</MainLayout>
