---
import MainLayout from '#layouts/main-layout.astro'
import Prose from '#components/prose.astro'
import Button from '#components/button.astro'
import { getCollection, render } from 'astro:content'
import { css } from 'styled-system/css'
import { container } from 'styled-system/patterns'
import { DownloadIcon } from '@lucide/astro'

const memoires = (await getCollection('memoires')).sort(
	(a, b) => a.data.date.getTime() - b.data.date.getTime()
)
const rendered = await Promise.all(
	memoires.map(async (m) => ({
		id: m.id,
		data: m.data,
		Content: (await render(m)).Content,
	}))
)

const wrapperClass = css({
	maxWidth: '65ch',
	marginInline: 'auto',
})

const h1Class = css({
	textStyle: 'heading-1',
	fontWeight: 'bold',
	color: 'default',
	mb: '12',
})

const listClass = css({
	'& > * + *': {
		mt: '14',
		pt: '14',
		borderTopWidth: '1px',
		borderColor: 'separator',
		md: { mt: '20', pt: '20' },
	},
})

const headerClass = css({
	mb: '10',
	pb: '8',
	borderBottomWidth: '1px',
	borderColor: 'separator',
	md: { mb: '12' },
})

const dateClass = css({
	textStyle: 'label',
	color: 'muted',
	fontVariantNumeric: 'oldstyle-nums',
	display: 'block',
	mb: '5',
})

const titleClass = css({
	textStyle: 'heading-2',
	fontWeight: 'normal',
	color: 'default',
	textWrap: 'balance',
	lineHeight: '1.15',
	letterSpacing: '-0.01em',
})

const actionsClass = css({
	display: 'flex',
	flexWrap: 'wrap',
	gap: '3',
	mt: '6',
})
---

<MainLayout title="Mémoires" description="Mémoires universitaires de Vanessa Noizet.">
	<div class={css({ py: '10', md: { py: '12' } })}>
		<div class={container()}>
			<div class={wrapperClass}>
				<h1 class={h1Class}>Mémoires</h1>
				<div class={listClass}>
					{
						rendered.map(({ data, Content }) => (
							<article>
								<header class={headerClass}>
									<time class={dateClass} datetime={String(data.date.getFullYear())}>
										{data.date.getFullYear()}
									</time>
									<h2 class={titleClass}>{data.title}</h2>
									{data.pdfs && data.pdfs.length > 0 && (
										<div class={actionsClass}>
											{data.pdfs.map((pdf) => (
												<Button as="a" href={pdf.url} target="_blank">
													<DownloadIcon size={16} />
													{pdf.label}
												</Button>
											))}
										</div>
									)}
								</header>
								<Prose>
									<Content />
								</Prose>
							</article>
						))
					}
				</div>
			</div>
		</div>
	</div>
</MainLayout>
