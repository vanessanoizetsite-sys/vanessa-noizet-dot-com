---
import MainLayout from '#layouts/main-layout.astro'
import { getStaticPathsFromCollection } from '#utils/get-static-paths-from-collection.ts'
import { render } from 'astro:content'
import { css } from 'styled-system/css'

export const getStaticPaths = getStaticPathsFromCollection('memoires')
const post = Astro.props
const { Content } = await render(post)
---

<MainLayout>
	<article>
		<h1 class={css({ textStyle: 'heading-1', fontWeight: 'bold', color: 'default' })}>
			{post.data.title}
		</h1>
		<Content />
	</article>
</MainLayout>
