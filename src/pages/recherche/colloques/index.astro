---
import MainLayout from '#layouts/main-layout.astro'
import Link from 'astro-typesafe-routes/link'
import { getCollection } from 'astro:content'
import { css } from 'styled-system/css'
const colloques = await getCollection('colloques')

const h1Class = css({ textStyle: 'heading-1', fontWeight: 'bold', color: 'default' })
const listClass = css({ '& > * + *': { mt: '2' } })
const linkClass = css({
	textStyle: 'body',
	color: 'default',
	textDecoration: 'underline',
	_hover: { color: 'muted' },
})
---

<MainLayout>
	<h1 class={h1Class}>Colloques</h1>
	<ul class={listClass}>
		{
			colloques.map((el) => (
				<li>
					<Link to="/recherche/colloques/[slug]" params={{ slug: el.id }} class={linkClass}>
						{el.data.title}
					</Link>
				</li>
			))
		}
	</ul>
</MainLayout>
