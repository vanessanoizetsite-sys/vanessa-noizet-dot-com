---
import MainLayout from '#layouts/main-layout.astro'
import Prose from '#components/prose.astro'
import Button from '#components/button.astro'
import ArrowLabel from '#components/arrow-label.astro'
import { getStaticPathsFromCollection } from '#utils/get-static-paths-from-collection.ts'
import { render } from 'astro:content'
import Link from 'astro-typesafe-routes/link'
import { css } from 'styled-system/css'
import { container } from 'styled-system/patterns'
import { DownloadIcon, ExternalLinkIcon } from '@lucide/astro'

export const getStaticPaths = getStaticPathsFromCollection('expositions')
const post = Astro.props
const { Content } = await render(post)
const hasBody = Boolean(post.body && post.body.trim().length > 0)
const images = post.data.images ?? []

const monthFr = (d: Date) =>
	d.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' })

const formatRange = (start: Date, end?: Date) => {
	if (!end) return monthFr(start)
	const sameYear = start.getFullYear() === end.getFullYear()
	if (sameYear) {
		const startM = start.toLocaleDateString('fr-FR', { month: 'long' })
		return `${startM} – ${monthFr(end)}`
	}
	return `${monthFr(start)} – ${monthFr(end)}`
}

const articleClass = css({ py: '8', md: { py: '12' } })

const backWrapClass = css({ mb: '8' })

const backLinkClass = css({
	color: 'muted',
	textDecoration: 'none',
	transition: 'color 220ms ease',
	_hover: { color: 'default' },
})

const heroClass = css({
	display: 'grid',
	gridTemplateColumns: '1fr',
	gap: '8',
	mb: '10',
	md: {
		gridTemplateColumns: 'minmax(0, 5fr) minmax(0, 4fr)',
		gap: '12',
		alignItems: 'end',
		mb: '16',
	},
})

const coverWrapClass = css({
	position: 'relative',
	overflow: 'hidden',
	bg: 'surface.2',
	aspectRatio: '4 / 5',
	md: { aspectRatio: '3 / 4' },
	'& img': {
		width: 'full',
		height: 'full',
		objectFit: 'cover',
		display: 'block',
	},
})

const metaColClass = css({
	display: 'flex',
	flexDirection: 'column',
	gap: '6',
})

const eyebrowClass = css({
	textStyle: 'label',
	color: 'muted',
})

const titleClass = css({
	textStyle: 'heading-1',
	fontWeight: 'normal',
	fontStyle: 'italic',
	color: 'default',
	textWrap: 'balance',
	lineHeight: '1.05',
	letterSpacing: '-0.015em',
})

const dlClass = css({
	display: 'grid',
	gridTemplateColumns: 'auto 1fr',
	columnGap: '6',
	rowGap: '3',
	borderTopWidth: '1px',
	borderBottomWidth: '1px',
	borderColor: 'separator',
	py: '5',
})

const dtClass = css({
	textStyle: 'label',
	color: 'muted',
	alignSelf: 'baseline',
})

const ddClass = css({
	textStyle: 'body',
	color: 'default',
	margin: 0,
})

const actionsClass = css({
	display: 'flex',
	flexWrap: 'wrap',
	gap: '3',
})

const bodyWrapClass = css({
	maxWidth: '68ch',
	marginInline: 'auto',
	mb: '14',
	md: { mb: '20' },
})

const galleryHeadingClass = css({
	textStyle: 'label',
	color: 'muted',
	mb: '6',
	display: 'flex',
	alignItems: 'baseline',
	gap: '3',
	'&::after': {
		content: '""',
		flex: '1',
		height: '1px',
		bg: 'separator',
	},
})

const galleryClass = css({
	display: 'grid',
	gridTemplateColumns: 'repeat(6, 1fr)',
	gap: '4',
	md: { gap: '6' },
})

const figureClass = css({
	margin: 0,
	gridColumn: 'span 6',
	'&[data-span="3"]': { md: { gridColumn: 'span 3' } },
	'&[data-span="4"]': { md: { gridColumn: 'span 4' } },
	'&[data-span="2"]': { md: { gridColumn: 'span 2' } },
})

const galleryItemClass = css({
	display: 'block',
	width: '100%',
	border: 0,
	padding: 0,
	background: 'none',
	cursor: 'zoom-in',
	overflow: 'hidden',
	bg: 'surface.2',
	'& img': {
		display: 'block',
		width: '100%',
		height: '100%',
		objectFit: 'cover',
		transition: 'transform 600ms cubic-bezier(0.2, 0.7, 0.2, 1)',
	},
	_hover: { '& img': { transform: 'scale(1.04)' } },
	_focusVisible: {
		outline: '2px solid token(colors.ring)',
		outlineOffset: '4px',
	},
})

const figcaptionClass = css({
	textStyle: 'caption',
	color: 'muted',
	mt: '2',
	fontStyle: 'italic',
	lineHeight: '1.5',
})

const lightboxClass = css({
	position: 'fixed',
	inset: 0,
	bg: 'rgba(20, 20, 22, 0.94)',
	display: 'none',
	alignItems: 'center',
	justifyContent: 'center',
	zIndex: 100,
	padding: '4',
	'&[data-open="true"]': { display: 'flex' },
})

const lightboxFrameClass = css({
	position: 'relative',
	maxWidth: 'min(1200px, 100%)',
	maxHeight: '100%',
	display: 'flex',
	flexDirection: 'column',
	gap: '4',
})

const lightboxImgClass = css({
	maxWidth: '100%',
	maxHeight: 'calc(100vh - 8rem)',
	objectFit: 'contain',
	display: 'block',
	marginInline: 'auto',
})

const lightboxCaptionClass = css({
	textStyle: 'small',
	color: 'surface.1',
	textAlign: 'center',
	fontStyle: 'italic',
	maxWidth: '60ch',
	marginInline: 'auto',
	opacity: 0.85,
})

const lightboxBtnClass = css({
	position: 'absolute',
	top: '50%',
	transform: 'translateY(-50%)',
	width: '48px',
	height: '48px',
	display: 'flex',
	alignItems: 'center',
	justifyContent: 'center',
	color: 'surface.1',
	bg: 'rgba(0,0,0,0.3)',
	border: '1px solid rgba(255,255,255,0.2)',
	borderRadius: 'full',
	cursor: 'pointer',
	fontSize: '20px',
	_hover: { bg: 'rgba(0,0,0,0.6)' },
})

const lightboxCloseClass = css({
	position: 'absolute',
	top: '4',
	right: '4',
	width: '40px',
	height: '40px',
	color: 'surface.1',
	bg: 'transparent',
	border: '1px solid rgba(255,255,255,0.3)',
	borderRadius: 'full',
	cursor: 'pointer',
	display: 'flex',
	alignItems: 'center',
	justifyContent: 'center',
	fontSize: '18px',
	_hover: { bg: 'rgba(255,255,255,0.1)' },
})

const lightboxCounterClass = css({
	position: 'absolute',
	top: '4',
	left: '4',
	textStyle: 'label',
	color: 'surface.1',
	opacity: 0.7,
})

const spanPattern = [4, 2, 3, 3, 2, 4, 3, 3, 6, 2, 4]
---

<MainLayout>
	<article class={articleClass}>
		<div class={container()}>
			<div class={backWrapClass}>
				<Link to="/expositions" class={backLinkClass}>
					<ArrowLabel direction="back">Retour aux expositions</ArrowLabel>
				</Link>
			</div>

			<header class={heroClass}>
				<div class={coverWrapClass}>
					<img src={post.data.cover.src} alt={post.data.cover.alt} />
				</div>
				<div class={metaColClass}>
					<span class={eyebrowClass}>
						{formatRange(post.data.date, post.data.dateEnd)}
					</span>
					<h1 class={titleClass}>{post.data.title}</h1>

					<dl class={dlClass}>
						<dt class={dtClass}>Lieu</dt>
						<dd class={ddClass}>{post.data.venue}</dd>
						{
							post.data.city && (
								<>
									<dt class={dtClass}>Ville</dt>
									<dd class={ddClass}>{post.data.city}</dd>
								</>
							)
						}
						{
							post.data.role && (
								<>
									<dt class={dtClass}>Rôle</dt>
									<dd class={ddClass}>{post.data.role}</dd>
								</>
							)
						}
					</dl>

					{
						(post.data.pdf || post.data.link) && (
							<div class={actionsClass}>
								{post.data.pdf && (
									<Button as="a" href={post.data.pdf} target="_blank">
										<DownloadIcon size={16} />
										Dossier de presse (PDF)
									</Button>
								)}
								{post.data.link && (
									<Button as="a" href={post.data.link.url} target="_blank" rel="noopener">
										<ExternalLinkIcon size={16} />
										{post.data.link.label}
									</Button>
								)}
							</div>
						)
					}
				</div>
			</header>

			{
				hasBody && (
					<div class={bodyWrapClass}>
						<Prose>
							<Content />
						</Prose>
					</div>
				)
			}

			{
				images.length > 0 && (
					<section>
						<h2 class={galleryHeadingClass}>
							<span>Galerie</span>
						</h2>
						<div class={galleryClass} data-gallery>
							{images.map((img, i) => (
								<figure class={figureClass} data-span={String(spanPattern[i % spanPattern.length])}>
									<button
										type="button"
										class={galleryItemClass}
										data-gallery-item
										data-index={String(i)}
										aria-label={`Agrandir ${img.alt}`}
									>
										<img src={img.src} alt={img.alt} loading="lazy" />
									</button>
									{img.caption && <figcaption class={figcaptionClass}>{img.caption}</figcaption>}
								</figure>
							))}
						</div>
					</section>
				)
			}
		</div>
	</article>

	{
		images.length > 0 && (
			<div class={lightboxClass} data-lightbox role="dialog" aria-modal="true" aria-label="Galerie">
				<button type="button" class={lightboxCloseClass} data-lightbox-close aria-label="Fermer">
					✕
				</button>
				<span class={lightboxCounterClass} data-lightbox-counter />
				<button
					type="button"
					class={lightboxBtnClass}
					style="left: 1rem;"
					data-lightbox-prev
					aria-label="Précédente"
				>
					←
				</button>
				<div class={lightboxFrameClass}>
					<img class={lightboxImgClass} data-lightbox-img alt="" />
					<p class={lightboxCaptionClass} data-lightbox-caption />
				</div>
				<button
					type="button"
					class={lightboxBtnClass}
					style="right: 1rem;"
					data-lightbox-next
					aria-label="Suivante"
				>
					→
				</button>
			</div>
		)
	}
</MainLayout>

<script is:inline define:vars={{ images }}>
	;(() => {
		const lightbox = document.querySelector('[data-lightbox]')
		if (!lightbox) return
		const imgEl = lightbox.querySelector('[data-lightbox-img]')
		const captionEl = lightbox.querySelector('[data-lightbox-caption]')
		const counterEl = lightbox.querySelector('[data-lightbox-counter]')
		const prevBtn = lightbox.querySelector('[data-lightbox-prev]')
		const nextBtn = lightbox.querySelector('[data-lightbox-next]')
		const closeBtn = lightbox.querySelector('[data-lightbox-close]')
		let current = 0
		let lastFocused = null

		const render = () => {
			const img = images[current]
			imgEl.src = img.src
			imgEl.alt = img.alt
			captionEl.textContent = img.caption || ''
			counterEl.textContent = `${String(current + 1).padStart(2, '0')} / ${String(images.length).padStart(2, '0')}`
		}

		const open = (i) => {
			current = i
			lastFocused = document.activeElement
			render()
			lightbox.setAttribute('data-open', 'true')
			document.body.style.overflow = 'hidden'
			closeBtn.focus()
		}

		const close = () => {
			lightbox.setAttribute('data-open', 'false')
			document.body.style.overflow = ''
			if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus()
		}

		const next = () => {
			current = (current + 1) % images.length
			render()
		}

		const prev = () => {
			current = (current - 1 + images.length) % images.length
			render()
		}

		document.querySelectorAll('[data-gallery-item]').forEach((el) => {
			el.addEventListener('click', () => {
				const i = Number(el.getAttribute('data-index'))
				open(i)
			})
		})

		nextBtn.addEventListener('click', next)
		prevBtn.addEventListener('click', prev)
		closeBtn.addEventListener('click', close)
		lightbox.addEventListener('click', (e) => {
			if (e.target === lightbox) close()
		})
		document.addEventListener('keydown', (e) => {
			if (lightbox.getAttribute('data-open') !== 'true') return
			if (e.key === 'Escape') close()
			else if (e.key === 'ArrowRight') next()
			else if (e.key === 'ArrowLeft') prev()
		})
	})()
</script>
